# 构建时 / 本地工具变量，不会作为 Worker 机密注入。
# 本地复制为 .env。生产写在 Cloudflare Builds 的构建变量里。

# --- 部署必填（cloudflare.config.ts 读取；本地开发可留空使用占位符） ---
# 注意：cloudflare.config.ts 只读取真实的环境变量，不读取 .env 文件，
# 所以这些值需要写在 Cloudflare Builds 的构建变量里。
WORKER_NAME=flare-blog
QUEUE_NAME=491227955b484d19860af8d9bdd6b2a1
DOMAIN=wsyblog.cn
D1_DATABASE_ID=f2aa1681-67e4-4725-93a9-3ddea0723f0a
KV_NAMESPACE_ID=55138d3faf9442709dad0ff99807b871
BUCKET_NAME=blog-media
# --- 域名绑定模式（可选，默认使用 Custom Domain 自定义域）---
# 若改用 Workers Routes 路由模式（如已有 DNS 代理记录），设为 1 即可；ZONE_NAME 默认从 DOMAIN 自动推导
# ROUTE=1
# ZONE_NAME=example.com

# --- 可选：构建时注入前端 ---
# VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key
# VITE_UMAMI_WEBSITE_ID=your-umami-website-id

# --- 本地 Drizzle（db:studio、db:push），不进 Worker ---
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_DATABASE_ID=your-d1-database-id
CLOUDFLARE_D1_TOKEN=your-d1-api-token
